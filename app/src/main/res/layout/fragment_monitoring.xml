<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true"
    tools:context=".ui.fragment.MonitoringFragment">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="실시간 모니터링"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btn_qr_settings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="⚙️ 발송 설정"
            android:textSize="13sp"
            android:background="@drawable/btn_secondary_style" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/title_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/stats_card_background"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_total_participants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 등록자"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/stats_card_background"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_current_inside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/status_inside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 입장"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/stats_card_background"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_total_visits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 방문"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/server_control_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/stats_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="웹 모니터링 서버"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_start_server"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="서버 시작"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_stop_server"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="서버 중지"
                android:layout_marginStart="8dp"
                android:enabled="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_server_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="서버 중지됨"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/primary_color"
            android:visibility="gone"
            android:background="@drawable/url_background"
            android:padding="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/file_management_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/stats_card_background"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/server_control_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁 파일 관리"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_upload_excel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 CSV 파일 업로드"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥 다운로드"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_download_excel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 현재 참가자 목록 CSV 다운로드"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_download_detailed_excel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 상세 출입 기록 CSV 다운로드"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_download_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 참가자 등록 템플릿 다운로드"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 QR 코드 발송"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_send_qr_codes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 QR 코드 일괄 발송"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_resend_qr_codes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 QR 코드 재전송" />

    </LinearLayout>

    <!-- Participants Section -->
    <LinearLayout
        android:id="@+id/participants_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/file_management_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 참가자 관리"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/et_participant_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="이름, 전화번호, 라이센스 검색"
                android:padding="12dp"
                android:background="@drawable/stats_card_background"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <Button
                android:id="@+id/btn_clear_participant_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="✕"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_secondary_style" />

        </LinearLayout>

        <!-- Tab Layout for Status Filter -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_status_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/stats_card_background"
            app:tabMode="scrollable"
            app:tabGravity="fill"
            app:tabTextColor="@color/text_secondary"
            app:tabSelectedTextColor="@color/primary_color"
            app:tabIndicatorColor="@color/primary_color" />

        <!-- Selection and Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_select_all_participants"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="전체선택"
                    android:background="@drawable/btn_secondary_style" />

                <Button
                    android:id="@+id/btn_delete_selected_participants"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="삭제"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_main_style"
                    android:enabled="false" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_participants_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0명"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_send_qr_to_selected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 선택자\nQR 발송"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_main_style"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btn_resend_qr_to_selected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔄 선택자\n재발송"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_secondary_style"
                    android:enabled="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- Participants List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_participants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_participant" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state_participants"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📭"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="참가자가 없습니다"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Recent Scans Section (collapsed) -->
    <TextView
        android:id="@+id/tv_recent_scans_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊 최근 스캔 기록"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/participants_section"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent_scans"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/tv_recent_scans_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_scan_record" />

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>